rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registos antigos (nome e e-mail, do tempo em que havia login): sem acesso pela app,
    // fechados pela regra por omissão. Apagam-se com scripts/apagar-registos.mjs.

    // Registo anónimo de cada simulação, para estatísticas agregadas.
    // Sem nome, e-mail nem identificador. Qualquer visitante pode criar; ninguém lê, altera nem apaga pela app
    // (a análise faz-se com o Admin SDK ou na consola).
    match /simulacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'criadoEm', 'versao', 'ecra', 'vista', 'modo', 'distrito', 'concelho', 'tipologia',
            'estacionamento', 'certificadoA', 'valorMaxCasa', 'resultado', 'inquilino', 'senhorio'])
        && request.resource.data.criadoEm == request.time
        && request.resource.data.versao is string && request.resource.data.versao.size() <= 20
        && request.resource.data.ecra in ['movel', 'computador']
        && request.resource.data.vista in ['inquilino', 'senhorio']
        && request.resource.data.modo in ['apartamento', 'quarto']
        && request.resource.data.distrito is string && request.resource.data.distrito.size() <= 60
        && request.resource.data.concelho is string && request.resource.data.concelho.size() <= 60
        && request.resource.data.tipologia is string && request.resource.data.tipologia.size() <= 4
        && request.resource.data.estacionamento is bool
        && request.resource.data.certificadoA is bool
        && request.resource.data.valorMaxCasa is number
        && request.resource.data.resultado in ['dentro', 'acima', 'requisitos', 'sem_renda', 'incompleto']
        && (!('inquilino' in request.resource.data)
            || (request.resource.data.inquilino is map && request.resource.data.inquilino.size() <= 8))
        && (!('senhorio' in request.resource.data)
            || (request.resource.data.senhorio is map && request.resource.data.senhorio.size() <= 12
                && request.resource.data.senhorio.get('quartos', []) is list
                && request.resource.data.senhorio.get('quartos', []).size() <= 12));
    }

    // Conteúdo do simulador, escrito apenas pelo script de publicação (Admin SDK). Aberto a todos.
    match /conteudo/simulador {
      allow read: if true;
    }
  }
}
